# RiverKin API — example environment. Copy to .env for local dev.
# NEVER commit a real .env or real secrets (CLAUDE.md hard rule).

# App environment: local | test | production
APP_ENV=local

# Async SQLAlchemy / asyncpg connection string.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/riverkin

# JWT signing secret — generate a strong random value for real deployments.
JWT_SECRET=change-me-dev-only

# Comma-separated list of allowed CORS origins (the web app).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Azure Blob storage for observation photos.
STORAGE_ACCOUNT_URL=https://example.blob.core.windows.net
PHOTO_CONTAINER=photos

# HAPI FHIR server base URL.
FHIR_BASE_URL=http://localhost:8080/fhir

# VLM provider for verify-question generation: none | moondream | hosted
VLM_PROVIDER=none
# Optional — only needed when VLM_PROVIDER is moondream or hosted.
VLM_API_KEY=
