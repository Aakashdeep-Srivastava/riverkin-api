# RiverKin API — example environment. Copy to .env for local dev.
# NEVER commit a real .env or real secrets (CLAUDE.md hard rule).

# App environment: local | test | production
APP_ENV=local

# Async SQLAlchemy / asyncpg connection string.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/riverkin

# JWT signing secret — generate a strong random value for real deployments.
JWT_SECRET=change-me-dev-only

# Comma-separated list of allowed CORS origins (the web app).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Azure Blob storage for observation photos.
STORAGE_ACCOUNT_URL=https://example.blob.core.windows.net
PHOTO_CONTAINER=photos

# HAPI FHIR server base URL.
FHIR_BASE_URL=http://localhost:8080/fhir

# VLM provider for verify-question generation: none | moondream | hosted
VLM_PROVIDER=none
# Optional — only needed when VLM_PROVIDER is moondream or hosted.
VLM_API_KEY=

# Azure AI Foundry — small, low-cost vision model for photo analysis + AI-generated
# likelihood. Leave endpoint/key empty to use the deterministic heuristic fallback
# (the field-check flow always works; the real model activates once these are set).
# Endpoint is the Foundry models base, e.g. https://<resource>.services.ai.azure.com/models
# Store FOUNDRY_VISION_KEY as a Container App secret in Azure, never in git.
FOUNDRY_VISION_ENDPOINT=
FOUNDRY_VISION_KEY=
FOUNDRY_VISION_MODEL=Phi-3.5-vision-instruct
FOUNDRY_API_VERSION=2024-05-01-preview

# Azure Maps account uniqueId (client id). Set in Azure as a plain env var
# (NOT a secret). The token is minted at runtime via managed identity, so no
# Azure Maps key is ever stored. Leave empty locally/CI to disable /maps/token.
AZURE_MAPS_CLIENT_ID=

# Strava OAuth — link a runner's activities. Register an app at
# https://www.strava.com/settings/api (callback domain = the API host). Store
# STRAVA_CLIENT_SECRET as a Container App secret, never in git. Leave empty to
# disable the "Connect Strava" button.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/api/v1/strava/callback
