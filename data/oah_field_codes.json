      "answers": ["none", "patches", "lots"]
    },
    {
      "riverkin_field": "flow",
      "question": "How is the flow?",
      "oah_code": "hydrology",
      "oah_display": "Hydrology of the stream",
      "status": "real",
      "answers": ["low", "normal", "high"]
    },
    {
