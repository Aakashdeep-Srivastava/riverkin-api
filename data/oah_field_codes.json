      "answers": ["clear", "slightly_cloudy", "cloudy", "very_turbid"]
    },
    {
      "riverkin_field": "foam",
      "question": "Is there foam on the surface?",
      "oah_code": "foam",
      "oah_display": "Foam/colour/smell",
