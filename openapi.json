    "/api/v1/verify/next": {
      "get": {
        "tags": [
          "verify"
        ],
        "summary": "Next Verify Items",
        "description": "Return the next verify cards for this voter.\n\nSkips items the voter already voted on and items whose observation is no\nlonger open. Gold items are included but never marked as gold in the payload.",
        "operationId": "next_verify_items_api_v1_verify_next_get",
        "parameters": [
          {
            "name": "n",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 20,
              "minimum": 1,
              "default": 5,
              "title": "N"
            }
          },
          {
            "name": "voter_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "demo-keeper",
              "title": "Voter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyNextOut"
                }
              }
            }
          },
