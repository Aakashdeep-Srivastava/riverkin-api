    "/api/v1/sites/{oah_code}/timeline": {
      "get": {
        "tags": [
          "sites"
        ],
        "summary": "Site Timeline",
        "description": "Checks, rain context and verifications for a site, newest first (C7).\n\nCombines real submitted observations with the site's rain/last-check context.",
        "operationId": "site_timeline_api_v1_sites__oah_code__timeline_get",
        "parameters": [
          {
            "name": "oah_code",
