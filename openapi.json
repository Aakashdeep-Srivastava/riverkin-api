    "/api/v1/observations": {
      "post": {
        "tags": [
          "observations"
        ],
        "summary": "Create Observation",
        "description": "Submit a field check: safety + quality gates, then draft verify items.\n\nSafety refusals return 403 + ``safety_reason`` (PRD). A pipe/outfall answer\nroutes the observation straight to expert review.",
        "operationId": "create_observation_api_v1_observations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ObservationIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservationCreated"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/observations/{observation_id}/photos": {
      "post": {
        "tags": [
          "observations"
        ],
        "summary": "Upload Photo",
        "description": "Upload one observation photo.\n\nRuns EXIF strip + Laplacian blur score + face blur + pHash, rejects reused\nimages (pHash distance < 8 against the site's past photos), and stores the\nprocessed bytes. A blurry photo returns 422 ``retake_photo``.",
        "operationId": "upload_photo_api_v1_observations__observation_id__photos_post",
        "parameters": [
          {
            "name": "observation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Observation Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_photo_api_v1_observations__observation_id__photos_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Upload Photo Api V1 Observations  Observation Id  Photos Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
